# ============================================================
# ai-work-assistant 配置示例
# 使用方法：cp .env.example .env 后填写。
# 约束：所有敏感信息与阈值只在此文件配置，代码中严禁硬编码。
#       .env 已被 .gitignore 忽略，不得提交到仓库。
# ============================================================

# ---------- 运行模式 ----------
# dry_run : 默认。只生成回复预览，不发送任何消息
# confirm : 生成预览，等待人工确认后才发送
# auto    : 白名单联系人自动回复（必须由使用者显式启用，不得作为默认值）
WXAGENT_MODE=dry_run

# ---------- 微信接入 ----------
# 目标会话白名单，逗号分隔；留空表示不自动回复任何人
WX_WHITELIST=
# 垃圾消息关键词，逗号分隔
WX_BLOCKLIST=
# 轮询间隔（秒）
WX_POLL_INTERVAL_S=2.0
# 备用测试小号标识，仅作人工核对提示。严禁使用日常主号。
WX_TEST_ACCOUNT=

# ---------- LLM（供应商 / 模型 / 接口地址均可替换）----------
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
# 单次生成最大 token 数
LLM_MAX_TOKENS=512

# ---------- 记忆 ----------
MEMORY_DB_PATH=var/memory/memory.db
# 短期记忆：有界近期对话窗口条数
MEMORY_SHORT_WINDOW=10
# 长期记忆保留期限（天）
MEMORY_LONG_TTL_DAYS=90

# ---------- 去重 ----------
# 合成消息 ID 的时间桶宽度（秒）
DEDUP_BUCKET_S=5
# 滑动时间窗宽度（秒）
DEDUP_WINDOW_S=60

# ---------- 发送控制 ----------
SEND_MIN_INTERVAL_S=3
# 回复长度上限
SEND_MAX_LEN=300
# 发送后读回确认的超时（秒）
SEND_READBACK_TIMEOUT_S=5
# 熔断：每会话每小时自动回复上限
SEND_MAX_PER_HOUR=20
# 熔断：连续自动回复上限
SEND_MAX_CONSECUTIVE=3

# ---------- 知识库 ----------
FAQ_PATH=src/wxagent/agent/knowledge/data/faq.yaml

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=var/logs
